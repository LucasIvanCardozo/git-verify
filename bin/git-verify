#!/usr/bin/env bash
#
# git-verify - Escanea un árbol de directorios y lista los repos git que
# encuentra, separando los que apuntan a GitHub de los que apuntan a otros
# remotes. Para cada repo muestra estado de cambios con formato compacto.
#
# Sin dependencias obligatorias más allá de bash, git y find. `mgitstatus`
# solo es necesario si usás --detailed.
#
#   https://github.com/fboender/multi-git-status

set -euo pipefail

# git NO debe pedir credenciales interactivamente. Si un fetch las
# requiere, falla limpio en vez de quedar colgado.
export GIT_TERMINAL_PROMPT=0

# -------- Defaults --------
SCAN_DIR="$HOME"
DEPTH=0           # 0 = sin límite (escanea todo el árbol bajo SCAN_DIR)
DO_FETCH=0
ONLY_PENDING=0
SHOW_DETAILED=0
EXCLUDE_NOISE=1

# Paths que casi nunca son "proyectos tuyos" pero contienen .git dirs.
NOISE_DIRS=(
  "*/.cache"
  "*/.local/share/Trash"
  "*/.nvm"
  "*/.pi/agent"
)

# Color solo si stdout es una terminal interactiva.
if [[ -t 1 ]]; then
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_RED=""
  C_GREEN=""
  C_YELLOW=""
  C_DIM=""
  C_BOLD=""
  C_RESET=""
fi

# Progreso (spinner + ETA) solo si stdout es TTY.
PROGRESS_ENABLED=0
SPIN_CHARS=""
SPIN_IDX=0
PROGRESS_START_S=0

# -------- Helpers --------
# Inicializa el sistema de progreso (spinner + ETA). No-op si no es TTY.
progress_init() {
  PROGRESS_START_S=$SECONDS
  if [[ ! -t 1 ]]; then
    PROGRESS_ENABLED=0
    return 0
  fi
  PROGRESS_ENABLED=1
  SPIN_IDX=0
  # Braille Unicode si la terminal lo soporta, si no ASCII clásico.
  if (locale charmap 2>/dev/null || echo UTF-8) | grep -qi 'utf'; then
    SPIN_CHARS="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
  else
    SPIN_CHARS='/-\|'
  fi
}

# Imprime línea de progreso in-place con \r.
# Args: current total label item_name
progress() {
  local current=$1 total=$2 label=$3 item=$4
  if [[ "$PROGRESS_ENABLED" -ne 1 ]]; then
    return 0
  fi
  local ch="${SPIN_CHARS:SPIN_IDX:1}"
  SPIN_IDX=$(( (SPIN_IDX + 1) % ${#SPIN_CHARS} ))

  # Truncar el nombre del item si fuera muy largo (línea única, no scrollea).
  local item_short="$item"
  if [[ "${#item_short}" -gt 30 ]]; then
    item_short="${item_short:0:27}..."
  fi

  # ETA: elapsed * (total - current) / current
  local eta_s=""
  if [[ "$current" -gt 0 && "$current" -lt "$total" ]]; then
    local elapsed=$(( SECONDS - PROGRESS_START_S ))
    local total_est=$(( elapsed * total / current ))
    local remaining=$(( total_est - elapsed ))
    if [[ "$remaining" -gt 0 ]]; then
      if [[ "$remaining" -lt 60 ]]; then
        eta_s=" ETA~${remaining}s"
      else
        local m=$(( remaining / 60 ))
        local s=$(( remaining % 60 ))
        eta_s=" ETA~${m}m${s}s"
      fi
    fi
  fi

  printf '\r\033[K%s %s [%d/%d] %s%s' \
    "$ch" "$label" "$current" "$total" "$item_short" "$eta_s"
}

# Termina la línea de progreso e imprime el summary final.
# Args: summary_line (ej "✓ gathered 30 repos in 4s")
progress_end() {
  local summary="$1"
  if [[ "$PROGRESS_ENABLED" -eq 1 ]]; then
    printf '\r\033[K%*s\r\033[K' 120 ""
  fi
  if [[ -n "$summary" ]]; then
    printf '%s\n' "$summary"
  fi
}

usage() {
  cat <<'EOF'
git-verify - Lista repos git, separando los de GitHub del resto

Uso:
  git-verify [OPCIONES] [DIRECTORIO]

Argumentos:
  DIRECTORIO         Raíz a escanear. Default: $HOME

Opciones:
  -d, --depth N      Profundidad máxima (default: 0 = sin límite).
                     Cuenta el dir de partida: raiz/<x>/.git = 2.
                     Con el default escaneamos el árbol completo.
      --fetch         Hace 'git fetch --quiet' antes. Toca cada remote.
                      Hace que "needs pull" sea preciso. Si algún repo
                      requiere autenticación, falla limpio (no queda
                      colgado pidiendo user/pass).
      --only-pending  Oculta los repos clean. Default: muestra todos.
      --detailed      Al final, llama a mgitstatus para info detallada
                      de los repos GitHub. Necesita mgitstatus instalado.
      --include-all   No excluye las carpetas de "ruido" (cache, trash,
                      nvm, .pi/agent). Por default se filtran.
  -h, --help         Esta ayuda.

Dependencias:
  bash, git, find   (mgitstatus solo es obligatorio con --detailed)

Carpetas de ruido excluidas por default:
  ~/.cache, ~/.local/share/Trash, ~/.nvm, ~/.pi/agent
EOF
}

err() { echo "Error: $*" >&2; }

is_github_repo() {
  local repo="$1" remote url
  while IFS= read -r remote; do
    [[ -z "$remote" ]] && continue
    url="$(git -C "$repo" config --get "remote.$remote.url" 2>/dev/null || true)"
    if [[ -n "$url" ]] && echo "$url" | grep -qi 'github.com'; then
      return 0
    fi
  done < <(git -C "$repo" remote 2>/dev/null || true)
  return 1
}

gather_repo_info() {
  local repo="$1"
  local branch="" remote_url="" staged=0 unstaged=0 untracked=0 upstream="" has_up=0 is_bare=0 is_clean=1

  if [[ "$(git -C "$repo" rev-parse --is-bare-repository 2>/dev/null || echo false)" == "true" ]]; then
    is_bare=1
  fi

  if [[ "$is_bare" -eq 0 ]]; then
    branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || true)"
    if [[ -z "$branch" ]]; then
      local _hash
      _hash="$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
      branch="detached:$_hash"
    fi
    if [[ "${#branch}" -gt 24 ]]; then
      branch="${branch:0:21}..."
    fi

    remote_url="$(git -C "$repo" config --get remote.origin.url 2>/dev/null || true)"
    if [[ -z "$remote_url" ]]; then
      local first_remote
      first_remote="$(git -C "$repo" remote 2>/dev/null | head -1 || true)"
      if [[ -n "$first_remote" ]]; then
        remote_url="$(git -C "$repo" config --get "remote.$first_remote.url" 2>/dev/null || true)"
      fi
    fi
    remote_url="${remote_url:-}"

    staged="$(git -C "$repo" diff --cached --name-only 2>/dev/null | wc -l || echo 0)"
    unstaged="$(git -C "$repo" diff --name-only 2>/dev/null | wc -l || echo 0)"
    untracked="$(git -C "$repo" ls-files --others --exclude-standard 2>/dev/null | wc -l || echo 0)"
    upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    [[ -n "$upstream" ]] && has_up=1

    if [[ "$staged" -eq 0 && "$unstaged" -eq 0 && "$untracked" -eq 0 && "$has_up" -eq 1 ]]; then
      is_clean=1
    else
      is_clean=0
    fi
  else
    branch="(bare)"
    remote_url=""
  fi

  printf '%s\n' "${repo}|${branch}|${remote_url}|${is_clean}|${staged}|${unstaged}|${untracked}|${has_up}|${is_bare}"
}

short_remote_tag() {
  local url="$1"
  if [[ -z "$url" ]]; then
    echo "sin remote"
    return
  fi
  local domain
  domain="$(echo "$url" \
    | sed -E 's|^https?://([^/]+)/.*$|\1|; s|^git@([^:]+):.*$|\1|; s|^ssh://git@([^/]+)/.*$|\1|')"
  case "$domain" in
    github.com)            echo "github" ;;
    gitlab.com|gitlab.*)   echo "gitlab" ;;
    bitbucket.org)         echo "bitbucket" ;;
    codeberg.org)          echo "codeberg" ;;
    sourcehut.org)         echo "sourcehut" ;;
    aur.archlinux.org)     echo "aur" ;;
    *)                     echo "$domain" ;;
  esac
}

fmt_count() {
  local n=$1 word=$2
  [[ "$n" -gt 0 ]] && echo "$n $word" || true
}

# Imprime la línea de un repo. Argumentos:
#   $1 = csv, $2 = name (basename), $3 = colored icon (con sus C_*),
#   $4 = branch, $5 = show_remote (0|1)
print_repo_line() {
  local csv="$1" name="$2" colored_icon="$3" branch="$4" show_remote="$5"
  IFS='|' read -r _ _ _ _ staged unstaged untracked has_up is_bare <<<"$csv"

  local -a parts=()
  [[ "$staged"    -gt 0 ]] && parts+=("$(fmt_count "$staged" "staged")")
  [[ "$unstaged"  -gt 0 ]] && parts+=("$(fmt_count "$unstaged" "unstaged")")
  [[ "$untracked" -gt 0 ]] && parts+=("$(fmt_count "$untracked" "untracked")")
  [[ "$has_up"    == "0" && "$is_bare" != "1" ]] && parts+=("needs upstream")
  local state=""
  if [[ "${#parts[@]}" -gt 0 ]]; then
    # printf repite formato por arg; usamos "%s · " y recortamos el " · " final.
    state="$(printf '%s · ' "${parts[@]}")"
    state="${state% · }"
  fi

  # Branch se oculta si es main/master/develop (cosas esperadas).
  local branch_tag=""
  case "$branch" in
    main|master|develop|"") branch_tag="" ;;
    *)                      branch_tag="($branch) " ;;
  esac

  if [[ "$show_remote" -eq 1 ]]; then
    local _url
    IFS='|' read -r _ _ _remote _ _ _ _ _ _ <<<"$csv"
    local tag
    tag="$(short_remote_tag "$_remote")"
    printf '  %s %s  %s%s%s [%s]%s\n' \
      "$colored_icon" "$name" "$branch_tag" "$state" \
      "$C_DIM" "$tag" "$C_RESET"
  else
    printf '  %s %s  %s%s\n' \
      "$colored_icon" "$name" "$branch_tag" "$state"
  fi
}

# Renderiza una sección (gh u otros). Lee los conteos y arrays globales.
render_section() {
  local section_type="$1"
  local title total dirty_n clean_n
  local -a dirty_arr clean_arr

  case "$section_type" in
    gh)
      title="GitHub"
      total=$gh_total
      dirty_n=$gh_dirty_count
      clean_n=$gh_clean_count
      if [[ "${#GH_DIRTY[@]}" -gt 0 ]]; then
        dirty_arr=("${GH_DIRTY[@]}")
      fi
      if [[ "${#GH_CLEAN[@]}" -gt 0 ]]; then
        clean_arr=("${GH_CLEAN[@]}")
      fi
      ;;
    other)
      title="Otros remotes"
      total=$other_total
      dirty_n=$other_dirty_count
      clean_n=$other_clean_count
      if [[ "${#OTHER_DIRTY[@]}" -gt 0 ]]; then
        dirty_arr=("${OTHER_DIRTY[@]}")
      fi
      if [[ "${#OTHER_CLEAN[@]}" -gt 0 ]]; then
        clean_arr=("${OTHER_CLEAN[@]}")
      fi
      ;;
  esac

  printf '%s▶ %s (%d repos · %d con cambios)%s\n' \
    "$C_BOLD" "$title" "$total" "$dirty_n" "$C_RESET"
  printf '%s%s%s\n' "$C_DIM" "------------------------------------------------------------" "$C_RESET"

  if [[ "$total" -eq 0 ]]; then
    printf '  %s(nada en esta categoría)%s\n' "$C_DIM" "$C_RESET"
    echo ""
    return
  fi

  # Dirty
  if [[ "$dirty_n" -gt 0 ]]; then
    for csv in "${dirty_arr[@]}"; do
      local name branch
      name="$(basename "${csv%%|*}")"
      IFS='|' read -r _ _ _ _ _ _ _ _ _ branch <<<"$csv"
      if [[ "$section_type" == "gh" ]]; then
        print_repo_line "$csv" "$name" "${C_RED}!${C_RESET}" "$branch" 0
      else
        print_repo_line "$csv" "$name" "${C_RED}!${C_RESET}" "$branch" 1
      fi
    done
  elif [[ "$ONLY_PENDING" -eq 0 && "$clean_n" -gt 0 ]]; then
    # No hay pendientes, vamos directo al bloque clean más abajo.
    printf '  %s(sin proyectos con cambios)%s\n' "$C_DIM" "$C_RESET"
  fi

  # Clean (solo si no estamos en --only-pending)
  if [[ "$ONLY_PENDING" -eq 0 && "$clean_n" -gt 0 ]]; then
    if [[ "$dirty_n" -gt 0 ]]; then
      printf '\n  %s─ clean (%d) ─%s\n' "$C_DIM" "$clean_n" "$C_RESET"
    fi
    for csv in "${clean_arr[@]}"; do
      local name branch is_bare
      name="$(basename "${csv%%|*}")"
      IFS='|' read -r _ _ _ _ _ _ _ _ is_bare branch <<<"$csv"
      if [[ "$is_bare" == "1" ]]; then
        printf '  %s- %s  %s(bare)%s\n' "$C_DIM" "$name" "$C_DIM" "$C_RESET"
      elif [[ "$section_type" == "gh" ]]; then
        print_repo_line "$csv" "$name" "${C_GREEN}✓${C_RESET}" "$branch" 0
      else
        print_repo_line "$csv" "$name" "${C_GREEN}✓${C_RESET}" "$branch" 1
      fi
    done
  fi
  echo ""
}

# -------- Parseo de argumentos --------
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)         usage; exit 0 ;;
    -d|--depth)
      [[ $# -ge 2 ]] || { err "falta valor para $1"; exit 2; }
      DEPTH="$2"; shift 2 ;;
    --depth=*)         DEPTH="${1#*=}"; shift ;;
    --fetch)           DO_FETCH=1; shift ;;
    --only-pending)    ONLY_PENDING=1; shift ;;
    --detailed)        SHOW_DETAILED=1; shift ;;
    --include-all)     EXCLUDE_NOISE=0; shift ;;
    --)                shift; while [[ $# -gt 0 ]]; do ARGS+=("$1"); shift; done ;;
    -*)                err "opción desconocida: $1"; usage; exit 2 ;;
    *)                 ARGS+=("$1"); shift ;;
  esac
done

if [[ "${#ARGS[@]}" -gt 0 ]]; then
  SCAN_DIR="${ARGS[0]}"
fi

# -------- Validaciones --------
[[ -d "$SCAN_DIR" ]] || { err "'$SCAN_DIR' no existe o no es un directorio."; exit 2; }

if [[ "$SHOW_DETAILED" -eq 1 ]] && ! command -v mgitstatus >/dev/null 2>&1; then
  cat >&2 <<'EOF'
mgitstatus no está instalado (solo es obligatorio con --detailed).

Para instalarlo:

  git clone https://github.com/fboender/multi-git-status.git
  cd multi-git-status
  make install                              # global (con sudo)
  # o sin sudo, solo para tu usuario:
  PREFIX=~/.local make install
EOF
  exit 127
fi

# -------- Descubrir repos --------
if [[ "$DEPTH" -eq 0 ]]; then
  FIND_ARGS=()
else
  FIND_ARGS=(-maxdepth "$DEPTH")
fi

PRUNE_ARGS=()
if [[ "$EXCLUDE_NOISE" -eq 1 ]]; then
  PRUNE_ARGS+=('(')
  i=0
  for noise in "${NOISE_DIRS[@]}"; do
    if [[ $i -gt 0 ]]; then
      PRUNE_ARGS+=('-o')
    fi
    PRUNE_ARGS+=('-path' "$noise")
    i=$((i + 1))
  done
  PRUNE_ARGS+=(')' '-prune' '-o')
fi

mapfile -t ALL_REPOS < <(
  find "$SCAN_DIR" "${PRUNE_ARGS[@]}" "${FIND_ARGS[@]}" -name .git -type d -prune -print 2>/dev/null \
    | sed 's|/\.git$||' | sort -u
)

if [[ "${#ALL_REPOS[@]}" -eq 0 ]]; then
  echo "No se encontraron repositorios git en '$SCAN_DIR' (depth=$DEPTH)."
  exit 0
fi

# -------- Optional fetch (con tolerancia) --------
declare -a FETCH_FAILURES=()
if [[ "$DO_FETCH" -eq 1 ]]; then
  fetch_total=${#ALL_REPOS[@]}
  progress_init
  i=0
  for repo in "${ALL_REPOS[@]}"; do
    i=$((i + 1))
    progress "$i" "$fetch_total" "fetching" "$(basename "$repo")"
    if ! git -C "$repo" fetch --quiet 2>/dev/null; then
      FETCH_FAILURES+=("$repo")
    fi
  done
  # Limpia la línea de progreso (clear va a barrer igual; pero por si el
  # usuario pipea a algo, dejamos la línea en blanco).
  progress_end ""
fi

# -------- Categorizar + gather --------
declare -a GH_DIRTY=()
declare -a GH_CLEAN=()
declare -a OTHER_DIRTY=()
declare -a OTHER_CLEAN=()
declare -a GH_PATHS=()
gh_total=0
other_total=0
gh_dirty_count=0
gh_clean_count=0
other_dirty_count=0
other_clean_count=0

gather_total=${#ALL_REPOS[@]}
progress_init
i=0
for repo in "${ALL_REPOS[@]}"; do
  i=$((i + 1))
  progress "$i" "$gather_total" "gathering" "$(basename "$repo")"
  csv="$(gather_repo_info "$repo")"
  IFS='|' read -r _ _ _ is_clean _ _ _ _ _ <<<"$csv"

  if is_github_repo "$repo"; then
    gh_total=$((gh_total + 1))
    GH_PATHS+=("$repo")
    if [[ "$is_clean" == "1" ]]; then
      gh_clean_count=$((gh_clean_count + 1))
      GH_CLEAN+=("$csv")
    else
      gh_dirty_count=$((gh_dirty_count + 1))
      GH_DIRTY+=("$csv")
    fi
  else
    other_total=$((other_total + 1))
    if [[ "$is_clean" == "1" ]]; then
      other_clean_count=$((other_clean_count + 1))
      OTHER_CLEAN+=("$csv")
    else
      other_dirty_count=$((other_dirty_count + 1))
      OTHER_DIRTY+=("$csv")
    fi
  fi
done
progress_end ""  # limpia la línea de progreso (el clear va a barrer igual)

# -------- Clear visual (solo TTY) --------
[[ -t 1 ]] && clear

# -------- Header --------
total=${#ALL_REPOS[@]}
total_dirty=$((gh_dirty_count + other_dirty_count))

printf '%sgit-verify%s  %d repos · %d con cambios pendientes\n' \
  "$C_BOLD" "$C_RESET" "$total" "$total_dirty"
if [[ "$SCAN_DIR" != "$HOME" ]]; then
  printf '%s%s%s\n' "$C_DIM" "$SCAN_DIR" "$C_RESET"
fi
[[ "$DO_FETCH" -eq 1 ]]     && printf '%sfetch activado · se tocó cada remote%s\n' "$C_DIM" "$C_RESET"
[[ "$ONLY_PENDING" -eq 1 ]] && printf '%sfiltro: solo pendientes%s\n' "$C_DIM" "$C_RESET"
echo ""

# -------- Secciones --------
render_section "gh"
render_section "other"

# -------- Resumen de fetch --------
if [[ "$DO_FETCH" -eq 1 ]]; then
  ok_count=$((${#ALL_REPOS[@]} - ${#FETCH_FAILURES[@]}))
  fail_count=${#FETCH_FAILURES[@]}
  printf '%sfetch: %d ok · %d fallaron (sin auth o sin red)%s\n' \
    "$C_DIM" "$ok_count" "$fail_count" "$C_RESET"
  if [[ "$fail_count" -gt 0 ]]; then
    for repo in "${FETCH_FAILURES[@]}"; do
      printf '         %s- %s%s\n' "$C_DIM" "$(basename "$repo")" "$C_RESET"
    done
  fi
  echo ""
fi

# -------- Sección detallada (opcional) --------
if [[ "$SHOW_DETAILED" -eq 1 && "${#GH_PATHS[@]}" -gt 0 ]]; then
  printf '%sDetalle de GitHub (mgitstatus)%s\n' "$C_BOLD" "$C_RESET"
  printf '%s%s%s\n' "$C_DIM" "------------------------------------------------------------" "$C_RESET"
  if [[ "$ONLY_PENDING" -eq 1 ]]; then
    mgitstatus -e "${GH_PATHS[@]}" 2>/dev/null || true
  else
    mgitstatus "${GH_PATHS[@]}" 2>/dev/null || true
  fi
fi
