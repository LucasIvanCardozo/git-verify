#!/usr/bin/env bash
#
# git-verify - Escanea un árbol de directorios y lista los repos git que
# encuentra, separando los que apuntan a GitHub de los que apuntan a otros
# remotes. Para cada repo muestra info útil: branch, remote y estado de
# cambios.
#
# Sin dependencias obligatorias más allá de bash, git y find. `mgitstatus`
# solo es necesario si usás --detailed.
#
#   https://github.com/fboender/multi-git-status

set -euo pipefail

# -------- Defaults --------
SCAN_DIR="$HOME"
DEPTH=2
DO_FETCH=0
ONLY_PENDING=0
SHOW_DETAILED=0

# -------- Helpers --------
usage() {
  cat <<'EOF'
git-verify - Lista repos git, separando los de GitHub del resto

Uso:
  git-verify [OPCIONES] [DIRECTORIO]

Argumentos:
  DIRECTORIO         Raíz a escanear. Default: $HOME

Opciones:
  -d, --depth N      Profundidad máxima (default: 2; 0 = sin límite).
                     Cuenta el dir de partida: raiz/<x>/.git = 2.
      --fetch         Hace 'git fetch --quiet' antes de chequear. Toca
                      cada remote. Hace que "needs pull" sea preciso.
      --only-pending  Oculta los repos clean. Default: muestra todos.
      --detailed      Al final, llama a mgitstatus para info detallada de
                      los repos GitHub. Necesita mgitstatus instalado.
  -h, --help         Esta ayuda.

Dependencias:
  bash, git, find   (mgitstatus solo es obligatorio con --detailed)
EOF
}

err() { echo "Error: $*" >&2; }

# Devuelve 0 si algún remote del repo apunta a github.com (case-insensitive).
is_github_repo() {
  local repo="$1" remote url
  while IFS= read -r remote; do
    [[ -z "$remote" ]] && continue
    url="$(git -C "$repo" config --get "remote.$remote.url" 2>/dev/null || true)"
    if [[ -n "$url" ]] && echo "$url" | grep -qi 'github.com'; then
      return 0
    fi
  done < <(git -C "$repo" remote 2>/dev/null || true)
  return 1
}

# Imprime una línea CSV (separada por '|') con info del repo.
# Campos: path|branch|remote|is_clean|staged|unstaged|untracked|has_upstream|is_bare
gather_repo_info() {
  local repo="$1"
  local branch="" remote_url="" staged=0 unstaged=0 untracked=0 upstream="" has_up=0 is_bare=0 is_clean=1

  # Bare repos los detectamos y etiquetamos (no tienen working dir).
  if [[ "$(git -C "$repo" rev-parse --is-bare-repository 2>/dev/null || echo false)" == "true" ]]; then
    is_bare=1
  fi

  if [[ "$is_bare" -eq 0 ]]; then
    branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || true)"
    if [[ -z "$branch" ]]; then
      # Detached HEAD: mostramos hash corto con prefijo para distinguirlo.
      local _hash
      _hash="$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
      branch="detached:$_hash"
    fi
    # Truncamos si fuera muy largo para mantener la línea legible.
    if [[ "${#branch}" -gt 24 ]]; then
      branch="${branch:0:21}..."
    fi

    remote_url="$(git -C "$repo" config --get remote.origin.url 2>/dev/null || true)"
    if [[ -z "$remote_url" ]]; then
      local first_remote
      first_remote="$(git -C "$repo" remote 2>/dev/null | head -1 || true)"
      if [[ -n "$first_remote" ]]; then
        remote_url="$(git -C "$repo" config --get "remote.$first_remote.url" 2>/dev/null || true)"
      fi
    fi
    remote_url="${remote_url:-"(sin remote)"}"

    staged="$(git -C "$repo" diff --cached --name-only 2>/dev/null | wc -l || echo 0)"
    unstaged="$(git -C "$repo" diff --name-only 2>/dev/null | wc -l || echo 0)"
    untracked="$(git -C "$repo" ls-files --others --exclude-standard 2>/dev/null | wc -l || echo 0)"
    if [[ "$staged" -eq 0 && "$unstaged" -eq 0 && "$untracked" -eq 0 ]]; then
      is_clean=1
    else
      is_clean=0
    fi

    upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    [[ -n "$upstream" ]] && has_up=1
  else
    branch="(bare)"
    remote_url="(bare)"
  fi

  printf '%s\n' "${repo}|${branch}|${remote_url}|${is_clean}|${staged}|${unstaged}|${untracked}|${has_up}|${is_bare}"
}

# Path relativo a SCAN_DIR para display; usa basename si quedan en ".".
relative_path() {
  local repo="$1"
  local rel
  rel="$(realpath --relative-to="$SCAN_DIR" "$repo" 2>/dev/null || true)"
  if [[ -z "$rel" || "$rel" == "." ]]; then
    rel="$(basename "$repo")"
  fi
  echo "$rel"
}

# Imprime la línea principal de un repo: icono + path + (branch) + remote.
print_repo_line() {
  local csv="$1" rel="$2"
  IFS='|' read -r _path branch remote is_clean _ _ _ _ is_bare <<<"$csv"
  if [[ "$is_bare" == "1" ]]; then
    printf '  - %-40s [bare]\n' "$rel"
    return
  fi
  local icon="✓"
  [[ "$is_clean" == "1" ]] || icon="!"
  printf '  %s %-40s  (%s)  %s\n' "$icon" "$rel" "$branch" "$remote"
}

# Imprime la sublínea con detalle de cambios si está sucio.
print_repo_status() {
  local csv="$1"
  IFS='|' read -r _ _ _ is_clean staged unstaged untracked has_up is_bare <<<"$csv"
  [[ "$is_clean" == "1" || "$is_bare" == "1" ]] && return
  local parts=()
  [[ "$staged"    -gt 0 ]] && parts+=("staged:$staged")
  [[ "$unstaged"  -gt 0 ]] && parts+=("unstaged:$unstaged")
  [[ "$untracked" -gt 0 ]] && parts+=("untracked:$untracked")
  [[ "$has_up"    == "0" ]] && parts+=("needs upstream")
  [[ "${#parts[@]}" -eq 0 ]] && parts+=("dirty")
  local joined
  joined="$(IFS=' · '; echo "${parts[*]}")"
  printf '       └─ %s\n' "$joined"
}

# -------- Parseo de argumentos --------
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)         usage; exit 0 ;;
    -d|--depth)
      [[ $# -ge 2 ]] || { err "falta valor para $1"; exit 2; }
      DEPTH="$2"; shift 2 ;;
    --depth=*)         DEPTH="${1#*=}"; shift ;;
    --fetch)           DO_FETCH=1; shift ;;
    --only-pending)    ONLY_PENDING=1; shift ;;
    --detailed)        SHOW_DETAILED=1; shift ;;
    --)                shift; while [[ $# -gt 0 ]]; do ARGS+=("$1"); shift; done ;;
    -*)                err "opción desconocida: $1"; usage; exit 2 ;;
    *)                 ARGS+=("$1"); shift ;;
  esac
done

if [[ "${#ARGS[@]}" -gt 0 ]]; then
  SCAN_DIR="${ARGS[0]}"
fi

# -------- Validaciones --------
[[ -d "$SCAN_DIR" ]] || { err "'$SCAN_DIR' no existe o no es un directorio."; exit 2; }

if [[ "$SHOW_DETAILED" -eq 1 ]] && ! command -v mgitstatus >/dev/null 2>&1; then
  cat >&2 <<'EOF'
mgitstatus no está instalado (solo es obligatorio con --detailed).

Para instalarlo:

  git clone https://github.com/fboender/multi-git-status.git
  cd multi-git-status
  make install                              # global (con sudo)
  # o sin sudo, solo para tu usuario:
  PREFIX=~/.local make install
EOF
  exit 127
fi

# -------- Descubrir repos --------
if [[ "$DEPTH" -eq 0 ]]; then
  FIND_ARGS=()
else
  FIND_ARGS=(-maxdepth "$DEPTH")
fi

mapfile -t ALL_REPOS < <(
  find "$SCAN_DIR" "${FIND_ARGS[@]}" -name .git -type d -prune -print 2>/dev/null \
    | sed 's|/\.git$||' | sort -u
)

if [[ "${#ALL_REPOS[@]}" -eq 0 ]]; then
  echo "No se encontraron repositorios git en '$SCAN_DIR' (depth=$DEPTH)."
  exit 0
fi

# -------- Optional fetch --------
if [[ "$DO_FETCH" -eq 1 ]]; then
  for repo in "${ALL_REPOS[@]}"; do
    git -C "$repo" fetch --quiet 2>/dev/null || true
  done
fi

# -------- Categorizar + gather --------
declare -a GH_INFO=()
declare -a OTHER_INFO=()
declare -a GH_PATHS=()       # paths originales para --detailed
gh_total=0
other_total=0

for repo in "${ALL_REPOS[@]}"; do
  if is_github_repo "$repo"; then
    gh_total=$((gh_total + 1))
    csv="$(gather_repo_info "$repo")"
    if [[ "$ONLY_PENDING" -eq 1 ]]; then
      IFS='|' read -r _ _ _ is_clean _ _ _ _ _ <<<"$csv"
      [[ "$is_clean" == "1" ]] && continue
    fi
    GH_INFO+=("$csv")
    GH_PATHS+=("$repo")
  else
    other_total=$((other_total + 1))
    csv="$(gather_repo_info "$repo")"
    if [[ "$ONLY_PENDING" -eq 1 ]]; then
      IFS='|' read -r _ _ _ is_clean _ _ _ _ _ <<<"$csv"
      [[ "$is_clean" == "1" ]] && continue
    fi
    OTHER_INFO+=("$csv")
  fi
done

# -------- Header --------
echo "git-verify — $SCAN_DIR (depth=$DEPTH)"
echo "${#ALL_REPOS[@]} repos | $gh_total en GitHub | $other_total en otros remotes"
[[ "$DO_FETCH" -eq 1 ]]     && echo "fetch activado · tocando cada remote"
[[ "$ONLY_PENDING" -eq 1 ]] && echo "filtro: solo pendientes"
echo ""

# -------- Sección GitHub --------
printf 'GitHub (%d)\n' "$gh_total"
printf -- '----------------------------------------\n'
if [[ "$gh_total" -eq 0 ]]; then
  echo "  (no se encontraron repos con remote en github.com)"
elif [[ "${#GH_INFO[@]}" -eq 0 ]]; then
  echo "  (todos clean con --only-pending)"
else
  for csv in "${GH_INFO[@]}"; do
    rel="$(relative_path "${csv%%|*}")"
    print_repo_line "$csv" "$rel"
    print_repo_status "$csv"
  done
fi
echo ""

# -------- Sección Otros --------
printf 'Otros remotes (%d)\n' "$other_total"
printf -- '----------------------------------------\n'
if [[ "$other_total" -eq 0 ]]; then
  echo "  (todos los repos apuntan a github.com, o no tienen remote)"
elif [[ "${#OTHER_INFO[@]}" -eq 0 ]]; then
  echo "  (todos clean con --only-pending)"
else
  for csv in "${OTHER_INFO[@]}"; do
    rel="$(relative_path "${csv%%|*}")"
    print_repo_line "$csv" "$rel"
    print_repo_status "$csv"
  done
fi

# -------- Sección detallada (opcional) --------
if [[ "$SHOW_DETAILED" -eq 1 && "${#GH_PATHS[@]}" -gt 0 ]]; then
  echo ""
  echo "Detalle de GitHub (mgitstatus)"
  echo "----------------------------------------"
  if [[ "$ONLY_PENDING" -eq 1 ]]; then
    mgitstatus -e "${GH_PATHS[@]}" 2>/dev/null || true
  else
    mgitstatus "${GH_PATHS[@]}" 2>/dev/null || true
  fi
fi
