#!/usr/bin/env bash
#
# git-verify - Escanea un árbol de directorios y lista los repos git que
# encuentra, separando los que apuntan a GitHub de los que apuntan a otros
# remotes. Para cada repo muestra estado de cambios con formato compacto.
#
# Sin dependencias obligatorias más allá de bash, git y find. `mgitstatus`
# solo es necesario si usás --detailed.
#
#   https://github.com/fboender/multi-git-status

set -euo pipefail

# git NO debe pedir credenciales interactivamente. Si un fetch las
# requiere, falla limpio en vez de quedar colgado.
export GIT_TERMINAL_PROMPT=0

# -------- Defaults --------
SCAN_DIR="$HOME"
DEPTH=0           # 0 = sin límite (escanea todo el árbol bajo SCAN_DIR)
DO_FETCH=0
ONLY_PENDING=0
SHOW_DETAILED=0
EXCLUDE_NOISE=1
FETCH_PARALLEL=4  # Fetch paralelo: default 4, máximo 16. 1 = serial (--no-parallel).
DO_PULL=0
PULL_FF_ONLY=1    # Default seguro: solo fast-forward. Override con --rebase o --no-ff-only.
PULL_REBASE=0
# Forzar bash puro en --pull (saltar gum). Se puede setear con flag --no-gum
# o variable de entorno GIT_VERIFY_NO_GUM=1. Útil cuando gum no se ve en tu
# terminal (problema conocido con Ghostty + bubbletea).
NO_GUM="${GIT_VERIFY_NO_GUM:-0}"
# Si --pull, fetch se activa implícitamente (lo marcamos acá y lo aplicamos
# despues de parsear args, en el bloque de auto-fetch).

# Paths que casi nunca son "proyectos tuyos" pero contienen .git dirs.
NOISE_DIRS=(
  "*/.cache"
  "*/.local/share/Trash"
  "*/.nvm"
  "*/.pi/agent"
)

# Color solo si stdout es una terminal interactiva.
if [[ -t 1 ]]; then
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_RED=""
  C_GREEN=""
  C_YELLOW=""
  C_DIM=""
  C_BOLD=""
  C_RESET=""
fi

# Progreso (spinner + ETA) solo si stdout es TTY.
PROGRESS_ENABLED=0
SPIN_CHARS=""
SPIN_IDX=0
PROGRESS_START_S=0

# -------- Helpers --------
# Inicializa el sistema de progreso (spinner + ETA). No-op si no es TTY.
progress_init() {
  PROGRESS_START_S=$SECONDS
  if [[ ! -t 1 ]]; then
    PROGRESS_ENABLED=0
    return 0
  fi
  PROGRESS_ENABLED=1
  SPIN_IDX=0
  # Braille Unicode si la terminal lo soporta, si no ASCII clásico.
  if (locale charmap 2>/dev/null || echo UTF-8) | grep -qi 'utf'; then
    SPIN_CHARS="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
  else
    SPIN_CHARS='/-\|'
  fi
}

# Imprime línea de progreso in-place con \r.
# Args: current total label item_name
progress() {
  local current=$1 total=$2 label=$3 item=$4
  if [[ "$PROGRESS_ENABLED" -ne 1 ]]; then
    return 0
  fi
  local ch="${SPIN_CHARS:SPIN_IDX:1}"
  SPIN_IDX=$(( (SPIN_IDX + 1) % ${#SPIN_CHARS} ))

  # Truncar el nombre del item si fuera muy largo (línea única, no scrollea).
  local item_short="$item"
  if [[ "${#item_short}" -gt 30 ]]; then
    item_short="${item_short:0:27}..."
  fi

  # ETA: elapsed * (total - current) / current
  local eta_s=""
  if [[ "$current" -gt 0 && "$current" -lt "$total" ]]; then
    local elapsed=$(( SECONDS - PROGRESS_START_S ))
    local total_est=$(( elapsed * total / current ))
    local remaining=$(( total_est - elapsed ))
    if [[ "$remaining" -gt 0 ]]; then
      if [[ "$remaining" -lt 60 ]]; then
        eta_s=" ETA~${remaining}s"
      else
        local m=$(( remaining / 60 ))
        local s=$(( remaining % 60 ))
        eta_s=" ETA~${m}m${s}s"
      fi
    fi
  fi

  printf '\r\033[K%s %s [%d/%d] %s%s' \
    "$ch" "$label" "$current" "$total" "$item_short" "$eta_s"
}

# Variante paralela: sin nombre del item (varios procesos corren a la vez).
# Args: current total label
progress_p() {
  local current=$1 total=$2 label=$3
  if [[ "$PROGRESS_ENABLED" -ne 1 ]]; then
    return 0
  fi
  local ch="${SPIN_CHARS:SPIN_IDX:1}"
  SPIN_IDX=$(( (SPIN_IDX + 1) % ${#SPIN_CHARS} ))

  local eta_s=""
  if [[ "$current" -gt 0 && "$current" -lt "$total" ]]; then
    local elapsed=$(( SECONDS - PROGRESS_START_S ))
    local total_est=$(( elapsed * total / current ))
    local remaining=$(( total_est - elapsed ))
    if [[ "$remaining" -gt 0 ]]; then
      if [[ "$remaining" -lt 60 ]]; then
        eta_s=" ETA~${remaining}s"
      else
        local m=$(( remaining / 60 ))
        local s=$(( remaining % 60 ))
        eta_s=" ETA~${m}m${s}s"
      fi
    fi
  fi
  printf '\r\033[K%s %s [%d/%d]%s' \
    "$ch" "$label" "$current" "$total" "$eta_s"
}

# Termina la línea de progreso e imprime el summary final.
# Args: summary_line (ej "✓ gathered 30 repos in 4s")
progress_end() {
  local summary="$1"
  if [[ "$PROGRESS_ENABLED" -eq 1 ]]; then
    printf '\r\033[K%*s\r\033[K' 120 ""
  fi
  if [[ -n "$summary" ]]; then
    printf '%s\n' "$summary"
  fi
}

# Spinner "busy" en background, para fases de duración desconocida
# (find, esperas cortas sin total ni ETA). Se actualiza solo y se detiene
# con spinner_stop.
SPINNER_PID=""
spinner_start() {
  local label="$1"
  [[ "$PROGRESS_ENABLED" -eq 1 ]] || return 0
  (
    while :; do
      local ch="${SPIN_CHARS:SPIN_IDX:1}"
      SPIN_IDX=$(( (SPIN_IDX + 1) % ${#SPIN_CHARS} ))
      printf '\r\033[K%s %s' "$ch" "$label"
      sleep 0.15
    done
  ) &
  SPINNER_PID=$!
}

spinner_stop() {
  if [[ -n "$SPINNER_PID" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
  fi
  if [[ "$PROGRESS_ENABLED" -eq 1 ]]; then
    printf '\r\033[K'  # limpiar línea
  fi
}

usage() {
  cat <<'EOF'
git-verify - Lista repos git, separando los de GitHub del resto

Uso:
  git-verify [OPCIONES] [DIRECTORIO]

Argumentos:
  DIRECTORIO         Raíz a escanear. Default: $HOME

Opciones:
  -d, --depth N      Profundidad máxima (default: 0 = sin límite).
                     Cuenta el dir de partida: raiz/<x>/.git = 2.
                     Con el default escaneamos el árbol completo.
      --fetch         Hace 'git fetch --quiet' antes. Toca cada remote.
                      Hace que "needs pull" sea preciso. Si algún repo
                      requiere autenticación, falla limpio (no queda
                      colgado pidiendo user/pass).
      --parallel N    Cantidad de fetches simultáneos con --fetch.
                      Default 4, máximo 16. Más no ayuda (la red se
                      satura). En modo paralelo el progress muestra
                      solo el contador global, no el item actual.
      --no-parallel   Desactiva el paralelismo de --fetch (forza serial).
      --pull          Después del render, deja elegir de entre los repos
                      con `!` cuáles hacer `git pull` (solo los que
                      pueden: behind > 0, working tree limpio, sin
                      divergencia). Activa fetch implícito. Default:
                      `git pull --ff-only` (no destructivo).
      --rebase        Con --pull, usa `git pull --rebase` en vez de
                      --ff-only. Reescribe tu historia local.
      --no-ff-only    Con --pull, usa `git pull` clásico (merge commit).
                      Menos seguro para scripts automáticos.
      --no-gum        Con --pull, fuerza el selector bash puro (números)
                      en vez de la TUI de gum. Útil si gum no se ve
                      en tu terminal (Ghostty + bubbletea son incompat
                      en algunas versiones). Equivale a GIT_VERIFY_NO_GUM=1.
      --only-pending  Oculta los repos clean. Default: muestra todos.
      --detailed      Al final, llama a mgitstatus para info detallada
                      de los repos GitHub. Necesita mgitstatus instalado.
      --include-all   No excluye las carpetas de "ruido" (cache, trash,
                      nvm, .pi/agent). Por default se filtran.
  -h, --help         Esta ayuda.

Dependencias:
  bash, git, find   (mgitstatus solo es obligatorio con --detailed,
                      gum solo si querés TUI bonita en --pull; sin gum
                      usa selector bash puro)

Carpetas de ruido excluidas por default:
  ~/.cache, ~/.local/share/Trash, ~/.nvm, ~/.pi/agent
EOF
}

err() { echo "Error: $*" >&2; }

is_github_repo() {
  local repo="$1" remote url
  while IFS= read -r remote; do
    [[ -z "$remote" ]] && continue
    url="$(git -C "$repo" config --get "remote.$remote.url" 2>/dev/null || true)"
    if [[ -n "$url" ]] && echo "$url" | grep -qi 'github.com'; then
      return 0
    fi
  done < <(git -C "$repo" remote 2>/dev/null || true)
  return 1
}

gather_repo_info() {
  local repo="$1"
  local branch="" remote_url="" staged=0 unstaged=0 untracked=0 upstream="" has_up=0 is_bare=0 is_clean=1 ahead=0 behind=0

  if [[ "$(git -C "$repo" rev-parse --is-bare-repository 2>/dev/null || echo false)" == "true" ]]; then
    is_bare=1
  fi

  if [[ "$is_bare" -eq 0 ]]; then
    branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || true)"
    if [[ -z "$branch" ]]; then
      local _hash
      _hash="$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
      branch="detached:$_hash"
    fi
    if [[ "${#branch}" -gt 24 ]]; then
      branch="${branch:0:21}..."
    fi

    remote_url="$(git -C "$repo" config --get remote.origin.url 2>/dev/null || true)"
    if [[ -z "$remote_url" ]]; then
      local first_remote
      first_remote="$(git -C "$repo" remote 2>/dev/null | head -1 || true)"
      if [[ -n "$first_remote" ]]; then
        remote_url="$(git -C "$repo" config --get "remote.$first_remote.url" 2>/dev/null || true)"
      fi
    fi
    remote_url="${remote_url:-}"

    staged="$(git -C "$repo" diff --cached --name-only 2>/dev/null | wc -l || echo 0)"
    unstaged="$(git -C "$repo" diff --name-only 2>/dev/null | wc -l || echo 0)"
    untracked="$(git -C "$repo" ls-files --others --exclude-standard 2>/dev/null | wc -l || echo 0)"
    upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    [[ -n "$upstream" ]] && has_up=1

    # Ahead/behind vs upstream. Solo si hay upstream configurado y NO
    # estamos en detached (en detached @{u} suele no estar definido o
    # apunta a un commit arbitrario). Usa refs remotas cacheadas locales:
    # si NO corriste --fetch, los números pueden estar stale — es honesto,
    # es lo que git sabe sin hablar con el server.
    #
    # Con `'@{u}'...HEAD` el formato es "<solo-en-upstream>	<solo-en-HEAD>".
    # El primer campo es lo que te falta pullear (behind), el segundo es
    # lo que te falta pushear (ahead).
    if [[ "$has_up" -eq 1 ]]; then
      local counts
      counts="$(git -C "$repo" rev-list --left-right --count '@{u}'...HEAD 2>/dev/null || echo "0	0")"
      behind="${counts%%	*}"
      ahead="${counts##*	}"
      ahead="${ahead:-0}"
      behind="${behind:-0}"
      # Sanity: si algo raro pasó (no-numérico), caer a 0.
      [[ "$ahead"  =~ ^[0-9]+$ ]] || ahead=0
      [[ "$behind" =~ ^[0-9]+$ ]] || behind=0
    fi

    if [[ "$staged" -eq 0 && "$unstaged" -eq 0 && "$untracked" -eq 0 \
       && "$ahead" -eq 0 && "$behind" -eq 0 && "$has_up" -eq 1 ]]; then
      is_clean=1
    else
      is_clean=0
    fi
  else
    branch="(bare)"
    remote_url=""
  fi

  printf '%s\n' "${repo}|${branch}|${remote_url}|${is_clean}|${staged}|${unstaged}|${untracked}|${has_up}|${is_bare}|${ahead}|${behind}"
}

short_remote_tag() {
  local url="$1"
  if [[ -z "$url" ]]; then
    echo "sin remote"
    return
  fi
  local domain
  domain="$(echo "$url" \
    | sed -E 's|^https?://([^/]+)/.*$|\1|; s|^git@([^:]+):.*$|\1|; s|^ssh://git@([^/]+)/.*$|\1|')"
  case "$domain" in
    github.com)            echo "github" ;;
    gitlab.com|gitlab.*)   echo "gitlab" ;;
    bitbucket.org)         echo "bitbucket" ;;
    codeberg.org)          echo "codeberg" ;;
    sourcehut.org)         echo "sourcehut" ;;
    aur.archlinux.org)     echo "aur" ;;
    *)                     echo "$domain" ;;
  esac
}

fmt_count() {
  local n=$1 word=$2
  [[ "$n" -gt 0 ]] && echo "$n $word" || true
}

# Imprime la línea de un repo. Argumentos:
#   $1 = csv, $2 = name (basename), $3 = colored icon (con sus C_*),
#   $4 = branch, $5 = show_remote (0|1)
print_repo_line() {
  local csv="$1" name="$2" colored_icon="$3" branch="$4" show_remote="$5"
  IFS='|' read -r _ _ _ _ staged unstaged untracked has_up is_bare ahead behind <<<"$csv"

  local -a parts=()
  [[ "$staged"    -gt 0 ]] && parts+=("$(fmt_count "$staged" "staged")")
  [[ "$unstaged"  -gt 0 ]] && parts+=("$(fmt_count "$unstaged" "unstaged")")
  [[ "$untracked" -gt 0 ]] && parts+=("$(fmt_count "$untracked" "untracked")")
  [[ "$ahead"     -gt 0 ]] && parts+=("$(fmt_count "$ahead" "ahead")")
  [[ "$behind"    -gt 0 ]] && parts+=("$(fmt_count "$behind" "behind")")
  [[ "$has_up"    == "0" && "$is_bare" != "1" ]] && parts+=("needs upstream")
  local state=""
  if [[ "${#parts[@]}" -gt 0 ]]; then
    # printf repite formato por arg; usamos "%s · " y recortamos el " · " final.
    state="$(printf '%s · ' "${parts[@]}")"
    state="${state% · }"
  fi

  # Branch se oculta si es main/master/develop (cosas esperadas).
  local branch_tag=""
  case "$branch" in
    main|master|develop|"") branch_tag="" ;;
    *)                      branch_tag="($branch) " ;;
  esac

  if [[ "$show_remote" -eq 1 ]]; then
    local _url
    IFS='|' read -r _ _ _remote _ _ _ _ _ ahead behind <<<"$csv"
    local tag
    tag="$(short_remote_tag "$_remote")"
    printf '  %s %s  %s%s%s [%s]%s\n' \
      "$colored_icon" "$name" "$branch_tag" "$state" \
      "$C_DIM" "$tag" "$C_RESET"
  else
    printf '  %s %s  %s%s\n' \
      "$colored_icon" "$name" "$branch_tag" "$state"
  fi
}

# Renderiza una sección (gh u otros). Lee los conteos y arrays globales.
render_section() {
  local section_type="$1"
  local title total dirty_n clean_n
  local -a dirty_arr clean_arr

  case "$section_type" in
    gh)
      title="GitHub"
      total=$gh_total
      dirty_n=$gh_dirty_count
      clean_n=$gh_clean_count
      if [[ "${#GH_DIRTY[@]}" -gt 0 ]]; then
        dirty_arr=("${GH_DIRTY[@]}")
      fi
      if [[ "${#GH_CLEAN[@]}" -gt 0 ]]; then
        clean_arr=("${GH_CLEAN[@]}")
      fi
      ;;
    other)
      title="Otros remotes"
      total=$other_total
      dirty_n=$other_dirty_count
      clean_n=$other_clean_count
      if [[ "${#OTHER_DIRTY[@]}" -gt 0 ]]; then
        dirty_arr=("${OTHER_DIRTY[@]}")
      fi
      if [[ "${#OTHER_CLEAN[@]}" -gt 0 ]]; then
        clean_arr=("${OTHER_CLEAN[@]}")
      fi
      ;;
  esac

  printf '%s▶ %s (%d repos · %d con cambios)%s\n' \
    "$C_BOLD" "$title" "$total" "$dirty_n" "$C_RESET"
  printf '%s%s%s\n' "$C_DIM" "------------------------------------------------------------" "$C_RESET"

  if [[ "$total" -eq 0 ]]; then
    printf '  %s(nada en esta categoría)%s\n' "$C_DIM" "$C_RESET"
    echo ""
    return
  fi

  # Dirty
  if [[ "$dirty_n" -gt 0 ]]; then
    for csv in "${dirty_arr[@]}"; do
      local name branch
      name="$(basename "${csv%%|*}")"
      IFS='|' read -r _ branch _ _ _ _ _ _ _ _ _ <<<"$csv"
      if [[ "$section_type" == "gh" ]]; then
        print_repo_line "$csv" "$name" "${C_RED}!${C_RESET}" "$branch" 0
      else
        print_repo_line "$csv" "$name" "${C_RED}!${C_RESET}" "$branch" 1
      fi
    done
  elif [[ "$ONLY_PENDING" -eq 0 && "$clean_n" -gt 0 ]]; then
    # No hay pendientes, vamos directo al bloque clean más abajo.
    printf '  %s(sin proyectos con cambios)%s\n' "$C_DIM" "$C_RESET"
  fi

  # Clean (solo si no estamos en --only-pending)
  if [[ "$ONLY_PENDING" -eq 0 && "$clean_n" -gt 0 ]]; then
    if [[ "$dirty_n" -gt 0 ]]; then
      printf '\n  %s─ clean (%d) ─%s\n' "$C_DIM" "$clean_n" "$C_RESET"
    fi
    for csv in "${clean_arr[@]}"; do
      local name branch is_bare
      name="$(basename "${csv%%|*}")"
      IFS='|' read -r _ branch _ _ _ _ _ _ _ is_bare _ _ <<<"$csv"
      if [[ "$is_bare" == "1" ]]; then
        printf '  %s- %s  %s(bare)%s\n' "$C_DIM" "$name" "$C_DIM" "$C_RESET"
      elif [[ "$section_type" == "gh" ]]; then
        print_repo_line "$csv" "$name" "${C_GREEN}✓${C_RESET}" "$branch" 0
      else
        print_repo_line "$csv" "$name" "${C_GREEN}✓${C_RESET}" "$branch" 1
      fi
    done
  fi
  echo ""
}

# -------- Pull phase (--pull) --------

# Filtra candidatos a pull. Un repo es candidato si:
#   - tiene upstream, no es bare, no es detached
#   - tiene behind > 0
#   - NO tiene ahead (divergente) — eso requiere --rebase manual
#   - working tree limpio (sin staged/unstaged/untracked)
# Lee los CSVs de los arrays globales GH_DIRTY/OTHER_DIRTY (los clean no
# pueden tener behind > 0 por la condición de is_clean).
# Poblamos PULL_CANDIDATES como array global de CSVs.
gather_pull_candidates() {
  PULL_CANDIDATES=()
  local csv
  for csv in "${GH_DIRTY[@]}" "${OTHER_DIRTY[@]}"; do
    local path staged unstaged untracked has_up is_bare ahead behind
    IFS='|' read -r path _ _ _ staged unstaged untracked has_up is_bare ahead behind <<<"$csv"
    if [[ "$behind" -gt 0 && "$ahead" -eq 0 \
       && "$staged" -eq 0 && "$unstaged" -eq 0 && "$untracked" -eq 0 \
       && "$has_up" -eq 1 && "$is_bare" -ne 1 ]]; then
      PULL_CANDIDATES+=("$csv")
    fi
  done
}

# Muestra TUI para elegir repos. Auto-detecta gum:
#   - si está: gum choose --no-limit, devuelve labels seleccionados
#   - si no: bash puro con números
# Argumentos: ninguno. Lee PULL_CANDIDATES.
# Devuelve por stdout una lista de paths newline-separated.
# Exit codes: 0 si hay selección, 1 si cancelado / inválido.
select_pull_targets() {
  local -a items=() labels=()
  local csv path name behind
  for csv in "${PULL_CANDIDATES[@]}"; do
    path="${csv%%|*}"
    name="$(basename "$path")"
    IFS='|' read -r _ _ _ _ _ _ _ _ _ _ behind <<<"$csv"
    items+=("$path")
    labels+=("$name | $behind behind")
  done

  local -a selected_paths=()

  # Decidir UNA vez si podemos usar gum. Necesitamos:
  #   - el user no haya pedido saltarlo (--no-gum o GIT_VERIFY_NO_GUM=1)
  #   - gum instalado
  #   - stdout sea TTY real
  #   - /dev/tty accesible (algunos entornos restringidos — VSCode,
  #     paneles de tmux con permisos raros, ssh sin -t, Ghostty con
  #     bubbletea — tienen stdout TTY pero gum o no puede abrir /dev/tty,
  #     o abre la TUI en alternate buffer que el emulador no renderiza)
  local use_gum=0
  if [[ "${NO_GUM:-0}" != "1" ]] \
     && command -v gum >/dev/null 2>&1 && [[ -t 1 ]] \
     && [[ -e /dev/tty && -r /dev/tty && -w /dev/tty ]]; then
    use_gum=1
  fi

  if [[ "${#labels[@]}" -eq 1 ]]; then
    # Único candidato: no abrimos selector, solo pedimos Enter.
    # Aplica tanto para gum como para bash puro (con 1 solo item no tiene
    # sentido abrir TUI).
    printf '\n%sHay 1 repo candidato para pull:%s\n' "$C_BOLD" "$C_RESET" >&2
    printf '  • %s\n' "${labels[0]}" >&2
    printf '\n%sEnter para hacer pull, Ctrl-C para cancelar: %s' "$C_DIM" "$C_RESET" >&2
    local _
    read -r _ || { return 1; }
    selected_paths=("${items[0]}")
  elif [[ "$use_gum" -eq 1 ]]; then
    # --- UX con gum, con timeout defensivo ---
    # timeout 30s + SIGKILL 5s después: si gum no responde a SIGTERM
    # (puede pasar si está bloqueado en syscall de TTY), lo matamos
    # forzosamente y caemos al bash puro. Mejor que dejar al usuario
    # con pantalla muerta.
    local picked_str
    picked_str="$(timeout --kill-after=5 30 gum choose --no-limit \
      --header "Seleccioná repos para hacer pull (espacio=toggle, enter=OK)" \
      --cursor-prefix " → " \
      --selected-prefix " ✓ " \
      "${labels[@]}" 2>/dev/null || true)"
    [[ -z "$picked_str" ]] && return 1
    local line
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      # line = "name | N behind"
      local pname="${line%% | *}"
      local i
      for i in "${!labels[@]}"; do
        if [[ "${labels[$i]%% | *}" == "$pname" ]]; then
          selected_paths+=("${items[$i]}")
          break
        fi
      done
    done <<<"$picked_str"
  else
    # --- UX bash puro ---
    # Toda la UI va a stderr (&2) para no contaminar el stdout que el caller
    # redirige al tmpfile con los paths seleccionados.
    printf '\n%sRepos disponibles para pull:%s\n' "$C_BOLD" "$C_RESET" >&2
    printf '%s%s%s\n' "$C_DIM" "------------------------------------------------------------" "$C_RESET" >&2
    local i
    for i in "${!labels[@]}"; do
      printf '  %s[%d]%s %s\n' "$C_DIM" "$((i+1))" "$C_RESET" "${labels[$i]}" >&2
    done
    printf '\n%sSeleccioná (ej: 1,3  o  1-3  o  all  o  q para salir): %s' "$C_DIM" "$C_RESET" >&2
    local sel
    read -r sel || sel=""
    case "${sel,,}" in
      ""|q|quit|n|no) return 1 ;;
      all|a)
        selected_paths=("${items[@]}")
        ;;
      *)
        # Parsear "1,3,5-7" → expandimos a [1,3,5,6,7]
        local -a picks=()
        local token part lo hi n
        IFS=',' read -ra parts <<<"$sel"
        for part in "${parts[@]}"; do
          part="${part// /}"  # trim spaces
          [[ -z "$part" ]] && continue
          if [[ "$part" == *-* ]]; then
            lo="${part%-*}"; hi="${part#*-}"
            for ((n=lo; n<=hi; n++)); do
              [[ "$n" -ge 1 && "$n" -le "${#items[@]}" ]] && picks+=("$n")
            done
          elif [[ "$part" =~ ^[0-9]+$ ]] && [[ "$part" -ge 1 && "$part" -le "${#items[@]}" ]]; then
            picks+=("$part")
          else
            printf '%s  (ignorando "%s")\n%s' "$C_DIM" "$part" "$C_RESET" >&2
          fi
        done
        # Deduplicar y mapear a paths
        local seen="" p
        for p in "${picks[@]}"; do
          if [[ ",$seen," != *",$p,"* ]]; then
            seen="${seen:+$seen,}$p"
            selected_paths+=("${items[$((p-1))]}")
          fi
        done
        ;;
    esac
  fi

  [[ "${#selected_paths[@]}" -gt 0 ]] || return 1
  printf '%s\n' "${selected_paths[@]}"
}

# Pide confirmación. Argumentos: $1=desc_cmd, $2..$N=paths.
# Devuelve 0 si 'y', 1 si no.
confirm_pull() {
  local cmd_desc="$1"; shift
  local -a targets=("$@")
  printf '\n%sVoy a hacer `%s` en %d repos:%s\n' \
    "$C_BOLD" "$cmd_desc" "${#targets[@]}" "$C_RESET"
  local t
  for t in "${targets[@]}"; do
    printf '  %s•%s %s\n' "$C_DIM" "$C_RESET" "$(basename "$t")"
  done
  printf '\n%s¿Continuar? [y/N] %s' "$C_BOLD" "$C_RESET"
  local ans
  read -r ans || ans=""
  case "${ans,,}" in
    y|yes|s|si|sí) return 0 ;;
    *) return 1 ;;
  esac
}

# Ejecuta git pull en un repo.
# $1=repo, $2=pull_cmd (ej "pull --ff-only").
# stdout: mensaje corto de resultado. exit: 0 ok, 1 fail.
run_pull_one() {
  local repo="$1" pull_cmd="$2"
  local out rc
  out="$(git -C "$repo" $pull_cmd 2>&1)"
  rc=$?
  if [[ $rc -eq 0 ]]; then
    if echo "$out" | grep -qi "Already up to date"; then
      printf 'ya estaba al día'
    else
      # Resumen de cambios: "N files changed, M insertions(+), K deletions(-)"
      local summary
      summary="$(echo "$out" \
        | grep -E '[0-9]+ files? changed(,)?( [0-9]+ insertions?\(.\))?( [0-9]+ deletions?\(.\))?' \
        | head -1 | sed 's/^[[:space:]]*//')"
      if [[ -n "$summary" ]]; then
        printf 'OK · %s' "$summary"
      else
        printf 'OK'
      fi
    fi
    return 0
  else
    local reason
    reason="$(echo "$out" | grep -iE 'fatal|error|not possible|diverged|conflict|couldn' | head -1 | sed 's/^[[:space:]]*//')"
    [[ -z "$reason" ]] && reason="pull falló (revisá a mano: git -C \"$repo\" status)"
    printf '%s' "$reason"
    return 1
  fi
}

# Orquesta: candidatos → selección → confirmación → loop pull → resumen.
pull_phase() {
  gather_pull_candidates
  if [[ "${#PULL_CANDIDATES[@]}" -eq 0 ]]; then
    printf '\n%s--pull: ningún repo es candidato (todos con cambios locales, divergentes o ya al día)%s\n' \
      "$C_DIM" "$C_RESET"
    return 0
  fi

  # Decidir comando
  local pull_cmd
  if [[ "$PULL_REBASE" -eq 1 ]]; then
    pull_cmd="pull --rebase"
  elif [[ "$PULL_FF_ONLY" -eq 1 ]]; then
    pull_cmd="pull --ff-only"
  else
    pull_cmd="pull"
  fi

  # Selección
  local -a selected=()
  local tmpfile
  tmpfile="$(mktemp 2>/dev/null || echo "/tmp/gv-pull-sel-$$")"
  if select_pull_targets > "$tmpfile" 2>/dev/null; then
    mapfile -t selected < "$tmpfile"
  fi
  rm -f "$tmpfile" 2>/dev/null

  if [[ "${#selected[@]}" -eq 0 ]]; then
    printf '\n%s--pull cancelado o sin selección%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi

  # Confirmación
  if ! confirm_pull "git $pull_cmd" "${selected[@]}"; then
    printf '\n%sCancelado por el usuario%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi

  # Loop
  printf '\n%s%s%s\n' "$C_BOLD" "Ejecutando pull..." "$C_RESET"
  printf '%s%s%s\n' "$C_DIM" "------------------------------------------------------------" "$C_RESET"

  local -a pull_ok=() pull_fail=()
  local repo name result rc i total
  total=${#selected[@]}
  i=0
  for repo in "${selected[@]}"; do
    i=$((i + 1))
    name="$(basename "$repo")"

    if [[ -t 1 ]]; then
      spinner_start "pulling $name..."
      result="$(run_pull_one "$repo" "$pull_cmd")"
      rc=$?
      spinner_stop
    else
      result="$(run_pull_one "$repo" "$pull_cmd")"
      rc=$?
    fi

    # Ancho fijo para el nombre: tomar el más largo del lote (cap 30)
    local maxlen=0 this_len
    local r
    for r in "${selected[@]}"; do
      this_len=${#r}
      [[ $this_len -gt 30 ]] && this_len=30
      (( this_len > maxlen )) && maxlen=$this_len
    done
    local pad=$((maxlen - ${#name})); [[ $pad -lt 1 ]] && pad=1
    local name_pad="$(printf '%*s' "$pad" '')"

    if [[ $rc -eq 0 ]]; then
      printf '  %s✓%s %s%s  %s\n' "$C_GREEN" "$C_RESET" "$name" "$name_pad" "$result"
      pull_ok+=("$repo")
    else
      printf '  %s✗%s %s%s  %s\n' "$C_RED" "$C_RESET" "$name" "$name_pad" "$result"
      pull_fail+=("$repo")
    fi
  done

  # Resumen final
  printf '\n%spull: %d ok · %d fallaron%s\n' \
    "$C_DIM" "${#pull_ok[@]}" "${#pull_fail[@]}" "$C_RESET"

  if [[ ${#pull_fail[@]} -gt 0 ]]; then
    printf '%sRepos fallidos (paths):%s\n' "$C_DIM" "$C_RESET"
    local r
    for r in "${pull_fail[@]}"; do
      printf '  %s•%s %s\n' "$C_DIM" "$C_RESET" "$r"
    done
  fi
}

# -------- Parseo de argumentos --------
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)         usage; exit 0 ;;
    -d|--depth)
      [[ $# -ge 2 ]] || { err "falta valor para $1"; exit 2; }
      DEPTH="$2"; shift 2 ;;
    --depth=*)         DEPTH="${1#*=}"; shift ;;
    --fetch)           DO_FETCH=1; shift ;;
    --parallel)
                      [[ $# -ge 2 ]] || { err "falta valor para $1"; exit 2; }
                      FETCH_PARALLEL="$2"
                      [[ "$FETCH_PARALLEL" -ge 0 ]] 2>/dev/null || { err "valor inválido para --parallel: $2"; exit 2; }
                      shift 2 ;;
    --parallel=*)      FETCH_PARALLEL="${1#*=}"
                      [[ "$FETCH_PARALLEL" -ge 0 ]] 2>/dev/null || { err "valor inválido para --parallel"; exit 2; }
                      shift ;;
    --no-parallel)     FETCH_PARALLEL=1; shift ;;
    --pull)            DO_PULL=1; shift ;;
    --rebase)          PULL_REBASE=1; PULL_FF_ONLY=0; shift ;;
    --no-ff-only)      PULL_FF_ONLY=0; shift ;;
    --no-gum)          NO_GUM=1; shift ;;
    --only-pending)    ONLY_PENDING=1; shift ;;
    --detailed)        SHOW_DETAILED=1; shift ;;
    --include-all)     EXCLUDE_NOISE=0; shift ;;
    --)                shift; while [[ $# -gt 0 ]]; do ARGS+=("$1"); shift; done ;;
    -*)                err "opción desconocida: $1"; usage; exit 2 ;;
    *)                 ARGS+=("$1"); shift ;;
  esac
done

if [[ "${#ARGS[@]}" -gt 0 ]]; then
  SCAN_DIR="${ARGS[0]}"
fi

# -------- Validaciones --------
[[ -d "$SCAN_DIR" ]] || { err "'$SCAN_DIR' no existe o no es un directorio."; exit 2; }

# --pull implica fetch: si no pasaste --fetch, lo activamos en silencio.
if [[ "$DO_PULL" -eq 1 && "$DO_FETCH" -eq 0 ]]; then
  DO_FETCH=1
fi

if [[ "$SHOW_DETAILED" -eq 1 ]] && ! command -v mgitstatus >/dev/null 2>&1; then
  cat >&2 <<'EOF'
mgitstatus no está instalado (solo es obligatorio con --detailed).

Para instalarlo:

  git clone https://github.com/fboender/multi-git-status.git
  cd multi-git-status
  make install                              # global (con sudo)
  # o sin sudo, solo para tu usuario:
  PREFIX=~/.local make install
EOF
  exit 127
fi

# -------- Descubrir repos --------
if [[ "$DEPTH" -eq 0 ]]; then
  FIND_ARGS=()
else
  FIND_ARGS=(-maxdepth "$DEPTH")
fi

PRUNE_ARGS=()
if [[ "$EXCLUDE_NOISE" -eq 1 ]]; then
  PRUNE_ARGS+=('(')
  i=0
  for noise in "${NOISE_DIRS[@]}"; do
    if [[ $i -gt 0 ]]; then
      PRUNE_ARGS+=('-o')
    fi
    PRUNE_ARGS+=('-path' "$noise")
    i=$((i + 1))
  done
  PRUNE_ARGS+=(')' '-prune' '-o')
fi

progress_init
spinner_start "scanning repositories under $SCAN_DIR..."
mapfile -t ALL_REPOS < <(
  find "$SCAN_DIR" "${PRUNE_ARGS[@]}" "${FIND_ARGS[@]}" -name .git -type d -prune -print 2>/dev/null \
    | sed 's|/\.git$||' | sort -u
)
spinner_stop

if [[ "${#ALL_REPOS[@]}" -eq 0 ]]; then
  echo "No se encontraron repositorios git en '$SCAN_DIR' (depth=$DEPTH)."
  exit 0
fi

# -------- Categorizar + gather (local, da feedback inmediato) --------
declare -a GH_DIRTY=()
declare -a GH_CLEAN=()
declare -a OTHER_DIRTY=()
declare -a OTHER_CLEAN=()
declare -a GH_PATHS=()
gh_total=0
other_total=0
gh_dirty_count=0
gh_clean_count=0
other_dirty_count=0
other_clean_count=0

gather_total=${#ALL_REPOS[@]}
progress_init
i=0
for repo in "${ALL_REPOS[@]}"; do
  i=$((i + 1))
  progress "$i" "$gather_total" "gathering" "$(basename "$repo")"
  csv="$(gather_repo_info "$repo")"
  IFS='|' read -r _ _ _ is_clean _ _ _ _ _ <<<"$csv"

  if is_github_repo "$repo"; then
    gh_total=$((gh_total + 1))
    GH_PATHS+=("$repo")
    if [[ "$is_clean" == "1" ]]; then
      gh_clean_count=$((gh_clean_count + 1))
      GH_CLEAN+=("$csv")
    else
      gh_dirty_count=$((gh_dirty_count + 1))
      GH_DIRTY+=("$csv")
    fi
  else
    other_total=$((other_total + 1))
    if [[ "$is_clean" == "1" ]]; then
      other_clean_count=$((other_clean_count + 1))
      OTHER_CLEAN+=("$csv")
    else
      other_dirty_count=$((other_dirty_count + 1))
      OTHER_DIRTY+=("$csv")
    fi
  fi
done
progress_end ""  # limpia la línea de progreso (el clear va a barrer igual)

# -------- Optional fetch (con tolerancia) --------
# Va DESPUES del gather: gather es local (rapido, da feedback inmediato),
# fetch es de red (lento). Asi el usuario ve progreso desde segundo 1.
declare -a FETCH_FAILURES=()
if [[ "$DO_FETCH" -eq 1 ]]; then
  fetch_total=${#ALL_REPOS[@]}
  # Cap de paralelismo
  if [[ "$FETCH_PARALLEL" -gt 16 ]]; then
    FETCH_PARALLEL=16
  fi
  # Si solo hay 1 repo, no tiene sentido paralelizar.
  [[ "$fetch_total" -le 1 ]] && FETCH_PARALLEL=1

  if [[ "$FETCH_PARALLEL" -le 1 ]]; then
    # Serial: progress con nombre del item.
    progress_init
    i=0
    for repo in "${ALL_REPOS[@]}"; do
      i=$((i + 1))
      progress "$i" "$fetch_total" "fetching" "$(basename "$repo")"
      if ! git -C "$repo" fetch --quiet 2>/dev/null; then
        FETCH_FAILURES+=("$repo")
      fi
    done
    progress_end ""
  else
    # Paralelo: lanzamiento los primeros N jobs YA, mostrar feedback
    # inmediato '[N/M] arrancando' antes del primer wait -n.
    fetch_tmpdir=$(mktemp -d 2>/dev/null) || fetch_tmpdir="/tmp/gv-fetch-$$"
    mkdir -p "$fetch_tmpdir"

    progress_init
    i=0

    # Fase 1: lanzar los primeros N jobs sin esperar.
    # Limitar el batch al total de repos disponibles.
    initial_batch=$FETCH_PARALLEL
    [[ "$initial_batch" -gt "$fetch_total" ]] && initial_batch="$fetch_total"

    for ((idx=0; idx<initial_batch; idx++)); do
      repo="${ALL_REPOS[$idx]}"
      (
        if ! git -C "$repo" fetch --quiet 2>/dev/null; then
          printf '%s\n' "$repo" > "$fetch_tmpdir/$(date +%s%N).$$.$BASHPID"
        fi
      ) &
    done
    i=$initial_batch
    progress_p "$i" "$fetch_total" "fetching..."

    # Fase 2: lanzar el resto mientras esperamos que se libere slot.
    for ((idx=initial_batch; idx<fetch_total; idx++)); do
      repo="${ALL_REPOS[$idx]}"
      # Esperar a que termine uno de los en vuelo.
      if wait -n 2>/dev/null; then :; fi  # bash 4.3+, toleramos fallos
      i=$((i + 1))
      progress_p "$i" "$fetch_total" "fetching..."

      # Lanzar el siguiente.
      (
        if ! git -C "$repo" fetch --quiet 2>/dev/null; then
          printf '%s\n' "$repo" > "$fetch_tmpdir/$(date +%s%N).$$.$BASHPID"
        fi
      ) &
    done

    # Fase 3: esperar a que terminen los que quedan en vuelo.
    # Cuántos quedan: total en vuelo = initial_batch (todos los que
    # lanzamos menos los que ya terminaron en fase 2).
    # Pero más simple: hacemos wait -n hasta que no haya más.
    # Cada wait -n devuelve cuando UNO termina. Necesitamos esperar
    # exactamente (initial_batch + (fetch_total - initial_batch)) - fetch_total
    # = 0... no, necesitamos esperar a todos los en vuelo.
    # Total lanzados = fetch_total. Terminados en fase 2 = (fetch_total - initial_batch).
    # Restantes = fetch_total - (fetch_total - initial_batch) = initial_batch.
    # PERO pueden haber terminado otros ya en fase 2 si fue muy rápido.
    # Hacemos un while con contador.
    launched=$fetch_total
    finished=$((fetch_total - initial_batch))  # los que terminaron en fase 2
    while [[ "$finished" -lt "$launched" ]]; do
      if wait -n 2>/dev/null; then :; fi
      finished=$((finished + 1))
      i=$((i + 1))
      [[ "$i" -le "$fetch_total" ]] && progress_p "$i" "$fetch_total" "fetching..."
    done

    # Asegurar progreso al 100%.
    [[ "$i" -lt "$fetch_total" ]] && progress_p "$fetch_total" "$fetch_total" "fetching..."

    # Recolectar fallas desde los archivos temporales.
    if [[ -d "$fetch_tmpdir" ]]; then
      while IFS= read -r failfile; do
        [[ -z "$failfile" ]] && continue
        FETCH_FAILURES+=("$(cat "$failfile" 2>/dev/null)")
      done < <(find "$fetch_tmpdir" -type f 2>/dev/null)
      rm -rf "$fetch_tmpdir" 2>/dev/null
    fi
    progress_end ""
  fi
fi

# -------- Clear visual (solo TTY) --------
[[ -t 1 ]] && clear

# -------- Header --------
total=${#ALL_REPOS[@]}
total_dirty=$((gh_dirty_count + other_dirty_count))

printf '%sgit-verify%s  %d repos · %d con cambios pendientes\n' \
  "$C_BOLD" "$C_RESET" "$total" "$total_dirty"
if [[ "$SCAN_DIR" != "$HOME" ]]; then
  printf '%s%s%s\n' "$C_DIM" "$SCAN_DIR" "$C_RESET"
fi
[[ "$DO_FETCH" -eq 1 ]]     && {
                          if [[ "$FETCH_PARALLEL" -le 1 ]]; then
                            printf '%sfetch activado · serial%s\n' "$C_DIM" "$C_RESET"
                          else
                            printf '%sfetch activado · %d jobs en paralelo%s\n' "$C_DIM" "$FETCH_PARALLEL" "$C_RESET"
                          fi
                        }
[[ "$ONLY_PENDING" -eq 1 ]] && printf '%sfiltro: solo pendientes%s\n' "$C_DIM" "$C_RESET"
echo ""

# -------- Secciones --------
render_section "gh"
render_section "other"

# -------- Resumen de fetch --------
if [[ "$DO_FETCH" -eq 1 ]]; then
  ok_count=$((${#ALL_REPOS[@]} - ${#FETCH_FAILURES[@]}))
  fail_count=${#FETCH_FAILURES[@]}
  printf '%sfetch: %d ok · %d fallaron (sin auth o sin red)%s\n' \
    "$C_DIM" "$ok_count" "$fail_count" "$C_RESET"
  if [[ "$fail_count" -gt 0 ]]; then
    for repo in "${FETCH_FAILURES[@]}"; do
      printf '         %s- %s%s\n' "$C_DIM" "$(basename "$repo")" "$C_RESET"
    done
  fi
  echo ""
fi

# -------- Sección detallada (opcional) --------
if [[ "$SHOW_DETAILED" -eq 1 && "${#GH_PATHS[@]}" -gt 0 ]]; then
  printf '%sDetalle de GitHub (mgitstatus)%s\n' "$C_BOLD" "$C_RESET"
  printf '%s%s%s\n' "$C_DIM" "------------------------------------------------------------" "$C_RESET"
  if [[ "$ONLY_PENDING" -eq 1 ]]; then
    mgitstatus -e "${GH_PATHS[@]}" 2>/dev/null || true
  else
    mgitstatus "${GH_PATHS[@]}" 2>/dev/null || true
  fi
fi

# -------- Pull interactivo (--pull) --------
if [[ "$DO_PULL" -eq 1 ]]; then
  pull_phase
fi
